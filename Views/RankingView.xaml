<UserControl x:Class="SmogShield_Pakistan.Views.RankingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:SmogShield_Pakistan.Views"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1600"
             Loaded="RankingView_Loaded"
             Background="#F3F4F6">

    <UserControl.Resources>
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WinBtnClose" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <Path x:Name="Ico" Data="{StaticResource Icon.WindowClose}"
                                  Fill="#333333" Stretch="Uniform" Width="11" Height="11"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter TargetName="Ico" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavActive" TargetType="Border">
            <Setter Property="Background" Value="#DCFCE7"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="NavIdle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3F4F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderGray}"
                BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Background="White" BorderBrush="{StaticResource BorderGray}" BorderThickness="1"
                            CornerRadius="6" Width="22" Height="22">
                        <Path Data="{StaticResource Icon.ShieldCheck}" Fill="#16A34A"
                              Stretch="Uniform" Width="12" Height="12"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="  SmogShield" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource DarkText}" VerticalAlignment="Center"/>
                    <TextBlock Text="  ·  Visitor Workspace" FontSize="11"
                               Foreground="{StaticResource LightGrayText}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource WinBtn}" Click="BtnMinimize_Click" ToolTip="Minimize">
                        <Path Data="{StaticResource Icon.WindowMinimize}" Fill="#333"
                              Stretch="Uniform" Width="11" Height="11"/>
                    </Button>
                    <Button Style="{StaticResource WinBtn}" Click="BtnMaximize_Click" ToolTip="Maximize / Restore">
                        <Path x:Name="MaxPath" Data="{StaticResource Icon.WindowMaximize}" Fill="#333"
                              Stretch="Uniform" Width="11" Height="11"/>
                    </Button>
                    <Button Style="{StaticResource WinBtnClose}" Click="BtnClose_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" MinWidth="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderGray}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,16,16,20">
                        <Border Background="{StaticResource LightGreen}" CornerRadius="8" Width="30" Height="30">
                            <Path Data="{StaticResource Icon.ShieldCheck}" Fill="#16A34A"
                                  Stretch="Uniform" Width="15" Height="15"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SmogShield" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource DarkText}"/>
                            <TextBlock Text="P A K I S T A N" FontSize="7"
                                       Foreground="{StaticResource LightGrayText}" Margin="0,-1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="12,0,12,0">
                        <TextBlock Text="WORKSPACE" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource LightGrayText}" Margin="12,0,0,8"/>

                        <Border Style="{StaticResource NavIdle}" MouseLeftButtonDown="NavDashboard_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Dashboard}" Fill="#6B7280"
                                      Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="  Dashboard" FontSize="13"
                                           Foreground="{StaticResource GrayText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NavActive}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.BarChart}" Fill="#16743F"
                                      Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="  Ranking" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#16743F" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NavIdle}" MouseLeftButtonDown="NavSearch_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Search}" Fill="#6B7280"
                                      Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="  Search" FontSize="13"
                                           Foreground="{StaticResource GrayText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NavIdle}" MouseLeftButtonDown="NavCompare_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.CompareArrows}" Fill="#6B7280"
                                      Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="  Compare" FontSize="13"
                                           Foreground="{StaticResource GrayText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NavIdle}" MouseLeftButtonDown="NavSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.SettingsGear}" Fill="#6B7280"
                                      Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="  Settings" FontSize="13"
                                           Foreground="{StaticResource GrayText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="2" VerticalAlignment="Bottom"
                            Background="#F0FDF4" CornerRadius="10" Padding="14" Margin="12,0,12,10">
                        <StackPanel>
                            <Path Data="{StaticResource Icon.Leaf}" Fill="#16743F"
                                  Stretch="Uniform" Width="20" Height="20" Margin="0,0,0,8"/>
                            <TextBlock Text="Awareness starts here." FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource DarkText}" Margin="0,0,0,4"/>
                            <TextBlock TextWrapping="Wrap" FontSize="10" LineHeight="14"
                                       Foreground="{StaticResource GrayText}"
                                       Text="Built to explore air quality and the algorithms behind it."/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Background="Transparent" Cursor="Hand"
                            Padding="16,12" BorderBrush="{StaticResource BorderGray}" BorderThickness="0,1,0,0"
                            MouseLeftButtonDown="BtnEndSession_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Logout}" Fill="#6B7280"
                                  Stretch="Uniform" Width="15" Height="15" VerticalAlignment="Center"/>
                            <TextBlock Text="  End visitor session" FontSize="12"
                                       Foreground="{StaticResource GrayText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderGray}"
                        BorderThickness="0,0,0,1" Padding="20,12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Workspace" FontSize="12"
                                       Foreground="{StaticResource LightGrayText}" VerticalAlignment="Center"/>
                            <Path Data="{StaticResource Icon.ChevronRight}" Fill="#9CA3AF"
                                  Stretch="Uniform" Width="12" Height="12" Margin="6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Ranking" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource DarkText}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="#F3F4F6" CornerRadius="6" Padding="10,4" Margin="0,0,14,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#9CA3AF" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SourceBadgeText" Text="  SAMPLE DATA" FontSize="10" FontWeight="Bold"
                                               Foreground="#6B7280" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource LightGreen}" CornerRadius="14"
                                    Width="28" Height="28" Margin="0,0,8,0">
                                <TextBlock x:Name="VisitorInitials" Text="V" FontSize="10" FontWeight="Bold" Foreground="#16743F"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="VisitorNameText" Text="Visitor" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource DarkText}"/>
                                <TextBlock x:Name="VisitorRoleText" Text="Guest · Visitor" FontSize="10"
                                           Foreground="{StaticResource LightGrayText}" Margin="0,-1,0,0"/>
                            </StackPanel>
                            <Path Data="{StaticResource Icon.ChevronDown}" Fill="#9CA3AF"
                                  Stretch="Uniform" Width="12" Height="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="24,20">
                    <StackPanel>

                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Pollution ranking" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource DarkText}"/>
                                <TextBlock Text="See how Pakistan's cities compare, from the highest concentration to the lowest."
                                           FontSize="13" Foreground="{StaticResource GrayText}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Path Data="{StaticResource Icon.Calendar}" Fill="#9CA3AF"
                                      Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DateText" Text="" FontSize="12"
                                           Foreground="{StaticResource GrayText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#F9FAFB" BorderBrush="{StaticResource BorderGray}"
                                BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Info}" Fill="#6B7280"
                                      Stretch="Uniform" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock FontSize="12" Foreground="{StaticResource GrayText}" VerticalAlignment="Center"
                                           x:Name="DataNoticeText" Text="Loading live data from OpenAQ…"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderGray}"
                                    BorderThickness="1" CornerRadius="10" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Cities in this snapshot" FontSize="11"
                                               Foreground="{StaticResource GrayText}" Margin="0,0,0,6"/>
                                    <Grid>
                                        <TextBlock x:Name="TxtTotalCities" Text="10" FontSize="30" FontWeight="Bold"
                                                   Foreground="{StaticResource DarkText}"/>
                                        <TextBlock Text="Across 5 regions" FontSize="11"
                                                   Foreground="{StaticResource LightGrayText}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderGray}"
                                    BorderThickness="1" CornerRadius="10" Padding="18">
                                <StackPanel>
                                    <TextBlock x:Name="TxtHighestLabel" Text="Highest PM2.5" FontSize="11"
                                               Foreground="{StaticResource GrayText}" Margin="0,0,0,6"/>
                                    <Grid>
                                        <TextBlock x:Name="TxtHighestVal" Text="128.6" FontSize="30" FontWeight="Bold"
                                                   Foreground="{StaticResource DarkText}"/>
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                            <TextBlock x:Name="TxtHighestCity" Text="Lahore" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource GrayText}" HorizontalAlignment="Right"/>
                                            <TextBlock x:Name="TxtHighestUnit" Text="µg/m³" FontSize="10"
                                                       Foreground="{StaticResource LightGrayText}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Background="White" BorderBrush="{StaticResource BorderGray}"
                                    BorderThickness="1" CornerRadius="10" Padding="18">
                                <StackPanel>
                                    <TextBlock x:Name="TxtLowestLabel" Text="Lowest PM2.5" FontSize="11"
                                               Foreground="{StaticResource GrayText}" Margin="0,0,0,6"/>
                                    <Grid>
                                        <TextBlock x:Name="TxtLowestVal" Text="35.2" FontSize="30" FontWeight="Bold"
                                                   Foreground="{StaticResource DarkText}"/>
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                            <TextBlock x:Name="TxtLowestCity" Text="Islamabad" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource GrayText}" HorizontalAlignment="Right"/>
                                            <TextBlock x:Name="TxtLowestUnit" Text="µg/m³" FontSize="10"
                                                       Foreground="{StaticResource LightGrayText}" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="White" BorderBrush="{StaticResource BorderGray}"
                                BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                            <StackPanel>

                                <Grid Margin="0,0,0,14">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="City pollution levels" FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource DarkText}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Path Data="{StaticResource Icon.Leaf}" Fill="#16A34A"
                                                  Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtAlgorithm" Text="  Sorted via Merge/Quick Sort Algorithm"
                                                       FontSize="11" Foreground="{StaticResource PrimaryGreenDark}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="Sort By" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{StaticResource GrayText}" Margin="0,0,0,4"/>
                                            <Border Background="White" BorderBrush="{StaticResource BorderGray}"
                                                    BorderThickness="1" CornerRadius="8" Padding="12,8"
                                                    Width="180" Cursor="Hand"
                                                    MouseLeftButtonDown="BtnSortDropdown_Click">
                                                <Grid>
                                                    <TextBlock x:Name="TxtSortValue" Text="Value - High to Low"
                                                               FontSize="12" Foreground="{StaticResource DarkText}"
                                                               VerticalAlignment="Center"/>
                                                    <Path Data="{StaticResource Icon.ChevronDown}" Fill="#9CA3AF"
                                                          Stretch="Uniform" Width="12" Height="12"
                                                          HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <Border x:Name="SortPopup" Visibility="Collapsed"
                                                    Background="White" BorderBrush="{StaticResource BorderGray}"
                                                    BorderThickness="1" CornerRadius="8" Padding="4"
                                                    Margin="0,4,0,0" Width="180" HorizontalAlignment="Right">
                                                <StackPanel>
                                                    <Border Background="#DCFCE7" CornerRadius="6" Padding="10,8" Cursor="Hand"
                                                            MouseLeftButtonDown="SortOption_HighLow">
                                                        <TextBlock Text="Value - High to Low" FontSize="12" Foreground="#16743F"/>
                                                    </Border>
                                                    <Border Background="Transparent" CornerRadius="6" Padding="10,8" Cursor="Hand"
                                                            MouseLeftButtonDown="SortOption_LowHigh">
                                                        <TextBlock Text="Value - Low to High" FontSize="12"
                                                                   Foreground="{StaticResource DarkText}"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <StackPanel>
                                            <TextBlock Text="Pollutant Type" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{StaticResource GrayText}" Margin="0,0,0,4"/>
                                            <Border Background="White" BorderBrush="{StaticResource BorderGray}"
                                                    BorderThickness="1" CornerRadius="8" Padding="12,8"
                                                    Width="120" Cursor="Hand"
                                                    MouseLeftButtonDown="BtnPollutantDropdown_Click">
                                                <Grid>
                                                    <TextBlock x:Name="TxtPollutantValue" Text="PM2.5"
                                                               FontSize="12" Foreground="{StaticResource DarkText}"
                                                               VerticalAlignment="Center"/>
                                                    <Path Data="{StaticResource Icon.ChevronDown}" Fill="#9CA3AF"
                                                          Stretch="Uniform" Width="12" Height="12"
                                                          HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>

                                            <Border x:Name="PollutantPopup" Visibility="Collapsed"
                                                    Background="White" BorderBrush="{StaticResource BorderGray}"
                                                    BorderThickness="1" CornerRadius="8" Padding="4"
                                                    Margin="0,4,0,0" Width="120" HorizontalAlignment="Right">
                                                <StackPanel>
                                                    <Border x:Name="OptPm25" Background="#DCFCE7" CornerRadius="6" Padding="10,8" Cursor="Hand"
                                                            MouseLeftButtonDown="PollutantOption_PM25">
                                                        <TextBlock Text="PM2.5" FontSize="12" Foreground="#16743F"/>
                                                    </Border>
                                                    <Border x:Name="OptPm10" Background="Transparent" CornerRadius="6" Padding="10,8" Cursor="Hand"
                                                            MouseLeftButtonDown="PollutantOption_PM10">
                                                        <TextBlock Text="PM10" FontSize="12"
                                                                   Foreground="{StaticResource DarkText}"/>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <Border Background="#F9FAFB" CornerRadius="6" Padding="14,10" Margin="0,0,0,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="RANK" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource GrayText}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="CITY" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource GrayText}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="POLLUTANT" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource GrayText}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="VALUE" FontSize="10" FontWeight="Bold"
                                                       Foreground="{StaticResource GrayText}" VerticalAlignment="Center"/>
                                            <Path Data="{StaticResource Icon.ArrowDown}" Fill="#16A34A"
                                                  Stretch="Uniform" Width="10" Height="10" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="4" Text="UNIT" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource GrayText}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <ItemsControl x:Name="RankingList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding RowBg}" CornerRadius="6" Padding="14,10" Margin="0,0,0,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="160"/>
                                                        <ColumnDefinition Width="80"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="28" Height="22" CornerRadius="6"
                                                                Background="{Binding RankBg}" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Rank}" FontSize="11" FontWeight="Bold"
                                                                       Foreground="{Binding RankFg}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <Border Background="{Binding Top5Bg}" CornerRadius="4" Padding="5,2"
                                                                Margin="6,0,0,0" VerticalAlignment="Center"
                                                                Visibility="{Binding Top5Vis}">
                                                            <TextBlock Text="TOP 5" FontSize="8" FontWeight="Bold"
                                                                       Foreground="{Binding Top5Fg}"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding City}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource DarkText}"/>
                                                        <TextBlock Text="{Binding Region}" FontSize="10"
                                                                   Foreground="{StaticResource LightGrayText}" Margin="0,1,0,0"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="2" Text="{Binding Pollutant}" FontSize="12"
                                                               Foreground="{StaticResource GrayText}" VerticalAlignment="Center"/>

                                                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ValueDisplay}" FontSize="12" FontWeight="Bold"
                                                                   Foreground="{StaticResource DarkText}" VerticalAlignment="Center"/>
                                                        <Border Width="{Binding BarWidth}" Height="3"
                                                                Background="{Binding BarColor}" CornerRadius="2"
                                                                Margin="10,0,0,0" VerticalAlignment="Center"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="4" Text="{Binding Unit}" FontSize="11"
                                                               Foreground="{StaticResource LightGrayText}"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border BorderBrush="{StaticResource BorderGray}" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,4,0,0">
                                    <Grid>
                                        <TextBlock x:Name="TxtShowing" Text="" FontSize="11"
                                                   Foreground="{StaticResource LightGrayText}"/>
                                        <Border Background="#F3F4F6" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                            <TextBlock x:Name="TxtOrder" Text="DESCENDING ORDER" FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource GrayText}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource BorderGray}"
                                BorderThickness="1" CornerRadius="10" Padding="20">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{StaticResource LightGreen}" CornerRadius="8"
                                            Width="36" Height="36" Margin="0,0,12,0">
                                        <Path Data="{StaticResource Icon.Layers}" Fill="#16743F"
                                              Stretch="Uniform" Width="16" Height="16"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Order the readings. Keep the context." FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource DarkText}"/>
                                        <TextBlock x:Name="TxtAlgoDetail" TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{StaticResource GrayText}" Margin="0,2,0,0"
                                                   Text="Merge Sort: O(n log n) · Quick Sort: average O(n log n). PM2.5 and PM10 are ranked separately; this view shows PM2.5 only."/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Background="Transparent" Cursor="Hand" Padding="8,6" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Top 5 → highest readings" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource PrimaryGreenDark}" VerticalAlignment="Center"/>
                                        <Path Data="{StaticResource Icon.ArrowRight}" Fill="#15803D"
                                              Stretch="Uniform" Width="12" Height="12" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
