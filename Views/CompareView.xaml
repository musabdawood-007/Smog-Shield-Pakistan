<UserControl x:Class="SmogShield_Pakistan.Views.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:SmogShield_Pakistan.Views"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1600"
             Loaded="CompareView_Loaded"
             Background="#F3F4F6">

    <UserControl.Resources>
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WinBtnClose" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <Path x:Name="Ico" Data="{StaticResource Icon.WindowClose}"
                                  Fill="#333333" Stretch="Uniform" Width="11" Height="11"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter TargetName="Ico" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavActive" TargetType="Border">
            <Setter Property="Background" Value="#DCFCE7"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="NavIdle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3F4F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderGray}"
                BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Background="White" BorderBrush="{StaticResource BorderGray}" BorderThickness="1"
                            CornerRadius="6" Width="22" Height="22">
                        <Path Data="{StaticResource Icon.ShieldCheck}" Fill="#16A34A"
                              Stretch="Uniform" Width="12" Height="12"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="  SmogShield" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource DarkText}" VerticalAlignment="Center"/>
                    <TextBlock Text="  ·  Visitor Workspace" FontSize="11"
                               Foreground="{StaticResource LightGrayText}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource WinBtn}" Click="BtnMinimize_Click" ToolTip="Minimize">
                        <Path Data="{StaticResource Icon.WindowMinimize}" Fill="#333"
                              Stretch="Uniform" Width="11" Height="11"/>
                    </Button>
                    <Button Style="{StaticResource WinBtn}" Click="BtnMaximize_Click" ToolTip="Maximize / Restore">
                        <Path x:Name="MaxPath" Data="{StaticResource Icon.WindowMaximize}" Fill="#333"
                              Stretch="Uniform" Width="11" Height="11"/>
                    </Button>
                    <Button Style="{StaticResource WinBtnClose}" Click="BtnClose_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" MinWidth="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderGray}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,16,16,20">
                        <Border Background="{StaticResource LightGreen}" CornerRadius="8" Width="30" Height="30">
                            <Path Data="{StaticResource Icon.ShieldCheck}" Fill="#16A34A"
                                  Stretch="Uniform" Width="15" Height="15"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SmogShield" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource DarkText}"/>
                            <TextBlock Text="P A K I S T A N" FontSize="7"
                                       Foreground="{StaticResource LightGrayText}" Margin="0,-1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="12,0,12,0">
                        <TextBlock Text="WORKSPACE" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource LightGrayText}" Margin="12,0,0,8"/>

                        <Border Style="{StaticResource NavIdle}" MouseLeftButtonDown="NavDashboard_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Dashboard}" Fill="#6B7280"
                                      Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="  Dashboard" FontSize="13"
                                           Foreground="{StaticResource GrayText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NavIdle}" MouseLeftButtonDown="NavRanking_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.BarChart}" Fill="#6B7280"
                                      Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="  Ranking" FontSize="13"
                                           Foreground="{StaticResource GrayText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NavIdle}" MouseLeftButtonDown="NavSearch_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Search}" Fill="#6B7280"
                                      Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="  Search" FontSize="13"
                                           Foreground="{StaticResource GrayText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NavActive}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.CompareArrows}" Fill="#16743F"
                                      Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="  Compare" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#16743F" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NavIdle}" MouseLeftButtonDown="NavSettings_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.SettingsGear}" Fill="#6B7280"
                                      Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="  Settings" FontSize="13"
                                           Foreground="{StaticResource GrayText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="2" VerticalAlignment="Bottom"
                            Background="#F0FDF4" CornerRadius="10" Padding="14" Margin="12,0,12,10">
                        <StackPanel>
                            <Path Data="{StaticResource Icon.Leaf}" Fill="#16743F"
                                  Stretch="Uniform" Width="20" Height="20" Margin="0,0,0,8"/>
                            <TextBlock Text="Awareness starts here." FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource DarkText}" Margin="0,0,0,4"/>
                            <TextBlock TextWrapping="Wrap" FontSize="10" LineHeight="14"
                                       Foreground="{StaticResource GrayText}"
                                       Text="Built to explore air quality and the algorithms behind it."/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Background="Transparent" Cursor="Hand"
                            Padding="16,12" BorderBrush="{StaticResource BorderGray}" BorderThickness="0,1,0,0"
                            MouseLeftButtonDown="BtnEndSession_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Logout}" Fill="#6B7280"
                                  Stretch="Uniform" Width="15" Height="15" VerticalAlignment="Center"/>
                            <TextBlock Text="  End visitor session" FontSize="12"
                                       Foreground="{StaticResource GrayText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderGray}"
                        BorderThickness="0,0,0,1" Padding="20,12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Workspace" FontSize="12"
                                       Foreground="{StaticResource LightGrayText}" VerticalAlignment="Center"/>
                            <Path Data="{StaticResource Icon.ChevronRight}" Fill="#9CA3AF"
                                  Stretch="Uniform" Width="12" Height="12" Margin="6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Compare" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource DarkText}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="#F3F4F6" CornerRadius="6" Padding="10,4" Margin="0,0,14,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#9CA3AF" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SourceBadgeText" Text="  SAMPLE DATA" FontSize="10" FontWeight="Bold"
                                               Foreground="#6B7280" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource LightGreen}" CornerRadius="14"
                                    Width="28" Height="28" Margin="0,0,8,0">
                                <TextBlock x:Name="VisitorInitials" Text="V" FontSize="10" FontWeight="Bold" Foreground="#16743F"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="VisitorNameText" Text="Visitor" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource DarkText}"/>
                                <TextBlock x:Name="VisitorRoleText" Text="Guest · Visitor" FontSize="10"
                                           Foreground="{StaticResource LightGrayText}" Margin="0,-1,0,0"/>
                            </StackPanel>
                            <Path Data="{StaticResource Icon.ChevronDown}" Fill="#9CA3AF"
                                  Stretch="Uniform" Width="12" Height="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="24,20">
                    <StackPanel>

                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Location comparison" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource DarkText}"/>
                                <TextBlock Text="Compare two city snapshots and explore the stations connected around them."
                                           FontSize="13" Foreground="{StaticResource GrayText}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Path Data="{StaticResource Icon.Calendar}" Fill="#9CA3AF"
                                      Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DateText" Text="" FontSize="12"
                                           Foreground="{StaticResource GrayText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#F9FAFB" BorderBrush="{StaticResource BorderGray}"
                                BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Info}" Fill="#6B7280"
                                      Stretch="Uniform" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock FontSize="12" Foreground="{StaticResource GrayText}" VerticalAlignment="Center"
                                           x:Name="DataNoticeText" Text="Loading live data from OpenAQ…"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{StaticResource LightGreen}" CornerRadius="6" Padding="10,4">
                                    <TextBlock x:Name="TxtPillPm" Text="PM2.5 · µg/m³" FontSize="11" FontWeight="Bold"
                                               Foreground="#16743F"/>
                                </Border>
                                <TextBlock Text="  Same pollutant, unit and observation time" FontSize="11"
                                           Foreground="{StaticResource GrayText}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtPillDate" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="11" Foreground="{StaticResource LightGrayText}"/>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderGray}"
                                    BorderThickness="1" CornerRadius="10" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="City A" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource GrayText}" Margin="0,0,0,6"/>

                                    <Border Background="#F9FAFB" BorderBrush="{StaticResource BorderGray}"
                                            BorderThickness="1" CornerRadius="8" Padding="12,10" Cursor="Hand"
                                            Margin="0,0,0,14" MouseLeftButtonDown="BtnCityADrop_Click">
                                        <Grid>
                                            <TextBlock x:Name="TxtCityA" Text="Lahore · Punjab" FontSize="13"
                                                       Foreground="{StaticResource DarkText}" VerticalAlignment="Center"/>
                                            <Path Data="{StaticResource Icon.ChevronDown}" Fill="#9CA3AF"
                                                  Stretch="Uniform" Width="12" Height="12"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <Border x:Name="CityAPopup" Visibility="Collapsed"
                                            Background="White" BorderBrush="{StaticResource BorderGray}"
                                            BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,-10,0,10"
                                            MaxHeight="340" MinWidth="230">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="330">
                                            <StackPanel x:Name="CityAPanel"/>
                                        </ScrollViewer>
                                    </Border>

                                    <TextBlock x:Name="CityAHeader" Text="CURRENT PM2.5 · CITY AVERAGE" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource LightGrayText}" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <TextBlock x:Name="TxtCityAPm" Text="128.6" FontSize="32" FontWeight="Bold"
                                                   Foreground="{StaticResource DarkText}"/>
                                        <TextBlock x:Name="CityAUnit" Text="  µg/m³" FontSize="12"
                                                   Foreground="{StaticResource LightGrayText}" Margin="0,0,0,6" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtCityAAqi" Text="214 US AQI · Very unhealthy" FontSize="11"
                                               Foreground="{StaticResource GrayText}" Margin="0,2,0,12"/>

                                    <Grid Margin="0,0,0,4">
                                        <TextBlock x:Name="TrendAHeader" Text="24-hour PM2.5 trend" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource DarkText}"/>
                                        <TextBlock x:Name="TrendAUnit" Text="Same scale · µg/m³" FontSize="9"
                                                   Foreground="{StaticResource LightGrayText}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border BorderBrush="{StaticResource BorderGray}" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                            <Canvas x:Name="TrendA" Width="300" Height="90" ClipToBounds="True"/>
                                        </Viewbox>
                                    </Border>
                                    <Grid x:Name="TrendATimeGrid" Margin="30,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="10:00" FontSize="8" Foreground="{StaticResource LightGrayText}"/>
                                        <TextBlock Grid.Column="1" Text="16:00" FontSize="8" Foreground="{StaticResource LightGrayText}"/>
                                        <TextBlock Grid.Column="2" Text="22:00" FontSize="8" Foreground="{StaticResource LightGrayText}"/>
                                        <TextBlock Grid.Column="3" Text="04:00" FontSize="8" Foreground="{StaticResource LightGrayText}"/>
                                        <TextBlock Grid.Column="4" Text="10:00" FontSize="8" Foreground="{StaticResource LightGrayText}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                                    <Border Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Background="{StaticResource LightGreen}" BorderBrush="#16A34A"
                                    BorderThickness="1.5" CornerRadius="10" Padding="14,12" Panel.ZIndex="10">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="% Difference" FontSize="10" FontWeight="SemiBold"
                                               Foreground="#16743F" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtDiffPct" Text="+64.0%" FontSize="22" FontWeight="Bold"
                                               Foreground="#16743F" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtDiffFormula" Text="(128.6 − 78.4) ÷ 78.4 × 100" FontSize="8"
                                               Foreground="#16A34A" HorizontalAlignment="Center" Margin="0,4,0,2"/>
                                    <TextBlock x:Name="TxtDiffAbs" Text="+50.2 µg/m³" FontSize="10" FontWeight="SemiBold"
                                               Foreground="#16743F" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderGray}"
                                    BorderThickness="1" CornerRadius="10" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="City B" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource GrayText}" Margin="0,0,0,6"/>

                                    <Border Background="#F9FAFB" BorderBrush="{StaticResource BorderGray}"
                                            BorderThickness="1" CornerRadius="8" Padding="12,10" Cursor="Hand"
                                            Margin="0,0,0,14" MouseLeftButtonDown="BtnCityBDrop_Click">
                                        <Grid>
                                            <TextBlock x:Name="TxtCityB" Text="Karachi · Sindh" FontSize="13"
                                                       Foreground="{StaticResource DarkText}" VerticalAlignment="Center"/>
                                            <Path Data="{StaticResource Icon.ChevronDown}" Fill="#9CA3AF"
                                                  Stretch="Uniform" Width="12" Height="12"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <Border x:Name="CityBPopup" Visibility="Collapsed"
                                            Background="White" BorderBrush="{StaticResource BorderGray}"
                                            BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,-10,0,10"
                                            MaxHeight="340" MinWidth="230">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="330">
                                            <StackPanel x:Name="CityBPanel"/>
                                        </ScrollViewer>
                                    </Border>

                                    <TextBlock x:Name="CityBHeader" Text="CURRENT PM2.5 · CITY AVERAGE" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource LightGrayText}" Margin="0,0,0,6"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <TextBlock x:Name="TxtCityBPm" Text="78.4" FontSize="32" FontWeight="Bold"
                                                   Foreground="{StaticResource DarkText}"/>
                                        <TextBlock x:Name="CityBUnit" Text="  µg/m³" FontSize="12"
                                                   Foreground="{StaticResource LightGrayText}" Margin="0,0,0,6" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtCityBAqi" Text="162 US AQI · Unhealthy" FontSize="11"
                                               Foreground="{StaticResource GrayText}" Margin="0,2,0,12"/>

                                    <Grid Margin="0,0,0,4">
                                        <TextBlock x:Name="TrendBHeader" Text="24-hour PM2.5 trend" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource DarkText}"/>
                                        <TextBlock x:Name="TrendBUnit" Text="Same scale · µg/m³" FontSize="9"
                                                   Foreground="{StaticResource LightGrayText}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Border BorderBrush="{StaticResource BorderGray}" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                            <Canvas x:Name="TrendB" Width="300" Height="90" ClipToBounds="True"/>
                                        </Viewbox>
                                    </Border>
                                    <Grid x:Name="TrendBTimeGrid" Margin="30,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="10:00" FontSize="8" Foreground="{StaticResource LightGrayText}"/>
                                        <TextBlock Grid.Column="1" Text="16:00" FontSize="8" Foreground="{StaticResource LightGrayText}"/>
                                        <TextBlock Grid.Column="2" Text="22:00" FontSize="8" Foreground="{StaticResource LightGrayText}"/>
                                        <TextBlock Grid.Column="3" Text="04:00" FontSize="8" Foreground="{StaticResource LightGrayText}"/>
                                        <TextBlock Grid.Column="4" Text="10:00" FontSize="8" Foreground="{StaticResource LightGrayText}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="White" BorderBrush="{StaticResource BorderGray}"
                                BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="NEARBY STATIONS (Graph BFS Traversal)" FontSize="15" FontWeight="Bold"
                                                   Foreground="{StaticResource DarkText}"/>
                                        <TextBlock x:Name="BfsSubtitle" Text="Loading nearby station network…"
                                                   FontSize="11" Foreground="{StaticResource GrayText}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Border Background="#F0FDF4" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                        <TextBlock Text="O(V + E)" FontSize="10" FontWeight="Bold" Foreground="#16743F"/>
                                    </Border>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2.2*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="1.1*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#F9FAFB" CornerRadius="8" Padding="8">
                                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                            <Canvas x:Name="GraphCanvas" Width="640" Height="360" ClipToBounds="True"/>
                                        </Viewbox>
                                    </Border>

                                    <Border Grid.Column="2" Background="#F9FAFB" CornerRadius="8" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="Visit nearby stations, level by level." FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource DarkText}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                            <StackPanel x:Name="BfsLevelsPanel"/>

                                            <Border BorderBrush="{StaticResource BorderGray}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource Icon.ListOrdered}" Fill="#16A34A"
                                                          Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="BfsFifoText" Text="  FIFO queue: waiting for station data" FontSize="11"
                                                               Foreground="#16743F" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Text="Edges represent geographic proximity, not roads. BFS visits by hop count, not shortest distance."
                                           FontSize="10" Foreground="{StaticResource LightGrayText}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0"
                                BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Info}" Fill="#16A34A"
                                      Stretch="Uniform" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtInsight" FontSize="12" Foreground="#16743F" TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           Text="Lahore's PM2.5 concentration is 64.0% higher than Karachi's. Karachi is the comparison baseline."/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
