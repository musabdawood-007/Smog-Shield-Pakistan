<UserControl x:Class="SmogShield_Pakistan.Views.AdminControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:SmogShield_Pakistan.Views"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1600"
             Loaded="AdminControlView_Loaded"
             Background="#F3F4F6">

    <UserControl.Resources>
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WinBtnClose" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <Path x:Name="Ico" Data="{StaticResource Icon.WindowClose}"
                                  Fill="#333333" Stretch="Uniform" Width="11" Height="11"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter TargetName="Ico" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavActive" TargetType="Border">
            <Setter Property="Background" Value="#DCFCE7"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="NavIdle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3F4F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderGray}"
                BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Background="White" BorderBrush="{StaticResource BorderGray}" BorderThickness="1"
                            CornerRadius="6" Width="22" Height="22">
                        <Path Data="{StaticResource Icon.ShieldCheck}" Fill="#16A34A"
                              Stretch="Uniform" Width="12" Height="12"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="  SmogShield" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource DarkText}" VerticalAlignment="Center"/>
                    <TextBlock Text="  ·  Administration" FontSize="11"
                               Foreground="{StaticResource LightGrayText}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource WinBtn}" Click="BtnMinimize_Click" ToolTip="Minimize">
                        <Path Data="{StaticResource Icon.WindowMinimize}" Fill="#333"
                              Stretch="Uniform" Width="11" Height="11"/>
                    </Button>
                    <Button x:Name="MaxBtn" Style="{StaticResource WinBtn}" Click="BtnMaximize_Click" ToolTip="Maximize / Restore">
                        <Path x:Name="MaxPath" Data="{StaticResource Icon.WindowMaximize}" Fill="#333"
                              Stretch="Uniform" Width="11" Height="11"/>
                    </Button>
                    <Button Style="{StaticResource WinBtnClose}" Click="BtnClose_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" MinWidth="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderGray}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,16,16,20">
                        <Border Background="{StaticResource LightGreen}" CornerRadius="8"
                                Width="30" Height="30">
                            <Path Data="{StaticResource Icon.ShieldCheck}" Fill="#16A34A"
                                  Stretch="Uniform" Width="15" Height="15"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SmogShield" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource DarkText}"/>
                            <TextBlock Text="P A K I S T A N" FontSize="7"
                                       Foreground="{StaticResource LightGrayText}" Margin="0,-1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="12,0,12,0">
                        <TextBlock Text="ADMIN CONTROL PANEL" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource LightGrayText}" Margin="12,0,0,8"/>

                        <Border x:Name="NavSystemStatus" Style="{StaticResource NavActive}" Cursor="Hand"
                                MouseLeftButtonDown="NavSystemStatus_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="NavSystemStatusIcon" Data="{StaticResource Icon.Server}" Fill="#16743F"
                                      Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavSystemStatusText" Text="  System Status" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#16743F" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="NavVisitorLogs" Style="{StaticResource NavIdle}" Cursor="Hand"
                                MouseLeftButtonDown="NavVisitorLogs_Click" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="NavVisitorLogsIcon" Data="{StaticResource Icon.ListOrdered}" Fill="#6B7280"
                                      Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavVisitorLogsText" Text="  Visitor Logs" FontSize="13"
                                           Foreground="{StaticResource GrayText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="2" VerticalAlignment="Bottom"
                            Background="#F0FDF4" CornerRadius="10" Padding="14" Margin="12,0,12,10">
                        <StackPanel>
                            <Path Data="{StaticResource Icon.ShieldCheck}" Fill="#16743F"
                                  Stretch="Uniform" Width="20" Height="20" Margin="0,0,0,8"/>
                            <TextBlock Text="Administrator access" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource DarkText}" Margin="0,0,0,4"/>
                            <TextBlock TextWrapping="Wrap" FontSize="10" LineHeight="14"
                                       Foreground="{StaticResource GrayText}"
                                       Text="System controls and visitor records stay separate from the public workspace."/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Background="Transparent" Cursor="Hand"
                            Padding="16,12" BorderBrush="{StaticResource BorderGray}" BorderThickness="0,1,0,0"
                            MouseLeftButtonDown="BtnLogout_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Logout}" Fill="#6B7280"
                                  Stretch="Uniform" Width="15" Height="15" VerticalAlignment="Center"/>
                            <TextBlock Text="  Logout" FontSize="12"
                                       Foreground="{StaticResource GrayText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderGray}"
                        BorderThickness="0,0,0,1" Padding="20,12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Administration" FontSize="12"
                                       Foreground="{StaticResource LightGrayText}" VerticalAlignment="Center"/>
                            <Path Data="{StaticResource Icon.ChevronRight}" Fill="#9CA3AF"
                                  Stretch="Uniform" Width="12" Height="12" Margin="6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Control Panel" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource DarkText}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="{StaticResource LightGreen}" CornerRadius="6" Padding="10,4" Margin="0,0,14,0">
                                <TextBlock Text="ADMIN ONLY" FontSize="10" FontWeight="Bold" Foreground="#16743F"/>
                            </Border>
                            <Border Background="{StaticResource LightGreen}" CornerRadius="14"
                                    Width="28" Height="28" Margin="0,0,8,0">
                                <Path Data="{StaticResource Icon.UserCog.Part2}" Fill="#16743F"
                                      Stretch="Uniform" Width="15" Height="15"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Demo administrator" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource DarkText}"/>
                                <TextBlock Text="Authorized admin session" FontSize="10"
                                           Foreground="{StaticResource LightGrayText}" Margin="0,-1,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="24,20">
                    <StackPanel>

                        <Grid Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Admin Control Panel" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource DarkText}"/>
                                <TextBlock Text="Keep the system healthy. Manage visitor submissions in one private workspace."
                                           FontSize="13" Foreground="{StaticResource GrayText}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Path Data="{StaticResource Icon.Calendar}" Fill="#9CA3AF"
                                      Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DateText" Text="" FontSize="12"
                                           Foreground="{StaticResource GrayText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#F9FAFB" BorderBrush="{StaticResource BorderGray}"
                                BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource Icon.Info}" Fill="#6B7280"
                                          Stretch="Uniform" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock FontSize="12" Foreground="{StaticResource GrayText}" VerticalAlignment="Center"
                                               Text="Live system health from OpenAQ · Visitor records are stored in SQL Server and can be exported or deleted."/>
                                </StackPanel>
                        </Border>

                        <Border x:Name="SystemHealthCard" Background="White" BorderBrush="{StaticResource BorderGray}"
                                BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16">
                            <StackPanel>

                                <Grid Margin="0,0,0,4">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="System Health" FontSize="16" FontWeight="Bold"
                                                   Foreground="{StaticResource DarkText}"/>
                                        <TextBlock Text="Connection, synchronization and service controls."
                                                   FontSize="12" Foreground="{StaticResource GrayText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border x:Name="SystemStatusBadgeBorder" Background="{StaticResource LightGreen}" CornerRadius="6"
                                            Padding="10,5" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="SystemStatusDot" Width="7" Height="7" Fill="#16A34A" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="SystemStatusBadge" Text="  ALL SYSTEMS OPERATIONAL" FontSize="10" FontWeight="Bold"
                                                       Foreground="#16743F" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,16,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#F9FAFB" CornerRadius="8" Padding="16">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="API Connection" FontSize="11"
                                                           Foreground="{StaticResource GrayText}" Margin="0,0,0,8"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Ellipse x:Name="ApiStatusDot" Width="8" Height="8" Fill="#16A34A" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="ApiStatusText" Text="Checking…" FontSize="18" FontWeight="Bold"
                                                               Foreground="{StaticResource DarkText}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock x:Name="ApiStatusSub" Text="OpenAQ API · Checking connection" FontSize="11"
                                                           Foreground="{StaticResource LightGrayText}"/>
                                            </StackPanel>
                                            <Path Data="{StaticResource Icon.PlugZap}" Fill="#9CA3AF"
                                                  Stretch="Uniform" Width="16" Height="16"
                                                  HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="2" Background="#F9FAFB" CornerRadius="8" Padding="16">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="Last Sync Time" FontSize="11"
                                                           Foreground="{StaticResource GrayText}" Margin="0,0,0,8"/>
                                                <TextBlock x:Name="SyncTimeText" Text="10:00:00 PKT" FontSize="18" FontWeight="Bold"
                                                           Foreground="{StaticResource DarkText}" Margin="0,0,0,6"/>
                                                <TextBlock x:Name="SyncDateText" Text="" FontSize="11"
                                                           Foreground="{StaticResource LightGrayText}"/>
                                            </StackPanel>
                                            <Path Data="{StaticResource Icon.Clock}" Fill="#9CA3AF"
                                                  Stretch="Uniform" Width="16" Height="16"
                                                  HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="4" Background="#F9FAFB" CornerRadius="8" Padding="16">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="Data Source" FontSize="11"
                                                           Foreground="{StaticResource GrayText}" Margin="0,0,0,8"/>
                                                <TextBlock x:Name="DataSourceText" Text="Sample data" FontSize="18" FontWeight="Bold"
                                                           Foreground="{StaticResource DarkText}" Margin="0,0,0,6"/>
                                                <TextBlock x:Name="DataSourceSub" Text="Waiting for first sync" FontSize="11"
                                                           Foreground="{StaticResource LightGrayText}"/>
                                            </StackPanel>
                                            <Path Data="{StaticResource Icon.Database}" Fill="#9CA3AF"
                                                  Stretch="Uniform" Width="16" Height="16"
                                                  HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{StaticResource PrimaryGreen}" CornerRadius="8"
                                                Padding="14,8" Cursor="Hand" Margin="0,0,8,0"
                                                MouseLeftButtonDown="BtnForceRefresh_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource Icon.RefreshCw}" Fill="White"
                                                      Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center"/>
                                                <TextBlock Text="  Force Refresh Data" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="White" BorderBrush="{StaticResource BorderGray}"
                                                BorderThickness="1" CornerRadius="8" Padding="14,8" Cursor="Hand" Margin="0,0,8,0"
                                                MouseLeftButtonDown="BtnClearCache_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource Icon.Eraser}" Fill="#333"
                                                      Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center"/>
                                                <TextBlock Text="  Clear Cache" FontSize="12"
                                                           Foreground="{StaticResource DarkText}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="LIVE CONTROLS" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource LightGrayText}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>

                                <Border Background="#F9FAFB" CornerRadius="6" Padding="12,8" Margin="0,14,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource Icon.Info}" Fill="#9CA3AF"
                                              Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock FontSize="11" Foreground="{StaticResource GrayText}" VerticalAlignment="Center"
                                                   Text="Force Refresh re-fetches OpenAQ now; Clear Cache drops cached readings and reverts to backup data."/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border x:Name="VisitorLogsCard" Background="White" BorderBrush="{StaticResource BorderGray}"
                                BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,16" Visibility="Collapsed">
                            <StackPanel>

                                <Grid Margin="0,0,0,14">
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Visitor Logs" FontSize="16" FontWeight="Bold"
                                                       Foreground="{StaticResource DarkText}" VerticalAlignment="Center"/>
                                            <Border Background="#F3F4F6" CornerRadius="6" Padding="8,3" Margin="10,0,0,0">
                                                <TextBlock x:Name="EntriesBadgeText" Text="0 ENTRIES" FontSize="10" FontWeight="Bold"
                                                           Foreground="{StaticResource GrayText}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Gateway form submissions · Visible only in the Admin Control Panel"
                                                   FontSize="12" Foreground="{StaticResource GrayText}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Border Background="White" BorderBrush="{StaticResource BorderGray}"
                                            BorderThickness="1" CornerRadius="8" Padding="12,7"
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                                            MouseLeftButtonDown="BtnExportCsv_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource Icon.Download}" Fill="#333"
                                                  Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="  Export All Visitors to CSV" FontSize="12"
                                                       Foreground="{StaticResource DarkText}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Background="#F9FAFB" CornerRadius="6" Padding="14,10" Margin="0,0,0,6">
                                    <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="TIMESTAMP ▼" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource GrayText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="NAME" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource GrayText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="EMAIL" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource GrayText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="PURPOSE" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource GrayText}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="ACTION" FontSize="10" FontWeight="Bold"
                                               Foreground="{StaticResource GrayText}" VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <ItemsControl x:Name="VisitorsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding RowBg}" CornerRadius="6" Padding="14,10" Margin="0,0,0,2">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130"/>
                                                        <ColumnDefinition Width="150"/>
                                                        <ColumnDefinition Width="200"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TimeText}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource DarkText}"/>
                                                        <TextBlock Text="{Binding DateText}" FontSize="10"
                                                                   Foreground="{StaticResource LightGrayText}" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12"
                                                               Foreground="{StaticResource DarkText}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Email}" FontSize="12"
                                                                   Foreground="{StaticResource GrayText}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding VisitText}" FontSize="10"
                                                                   Foreground="{StaticResource LightGrayText}" Margin="0,1,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="3" Text="{Binding Purpose}" FontSize="12"
                                                               Foreground="{StaticResource DarkText}" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                            Background="Transparent" Cursor="Hand" Padding="6,4"
                                                            Tag="{Binding Id}" MouseLeftButtonDown="BtnDeleteVisitor_Click">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Path Data="{StaticResource Icon.Trash}" Fill="#DC2626"
                                                                  Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center"/>
                                                            <TextBlock Text="  Delete Entry" FontSize="11" Foreground="#DC2626"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border BorderBrush="{StaticResource BorderGray}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                    <Grid>
                                        <TextBlock x:Name="VisitorsFooterText" Text="Showing visitor submissions · Newest first · Times in PKT"
                                                   FontSize="11" Foreground="{StaticResource LightGrayText}"/>
                                        <TextBlock Text="Saved in SQL Server · SmogShieldDB"
                                                   FontSize="11" Foreground="{StaticResource LightGrayText}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
