<UserControl x:Class="SmogShield_Pakistan.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:SmogShield_Pakistan.Views"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1600"
             Loaded="SettingsView_Loaded"
             Background="#F3F4F6">

    <UserControl.Resources>
        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WinBtnClose" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <Path x:Name="Ico" Data="{StaticResource Icon.WindowClose}"
                                  Fill="#333333" Stretch="Uniform" Width="11" Height="11"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter TargetName="Ico" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavActive" TargetType="Border">
            <Setter Property="Background" Value="#DCFCE7"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="NavIdle" TargetType="Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F3F4F6"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="UnitBtn" TargetType="Border">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="UnitBtnActive" TargetType="Border">
            <Setter Property="Background" Value="#DCFCE7"/>
            <Setter Property="BorderBrush" Value="#16A34A"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderGray}"
                BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Background="White" BorderBrush="{StaticResource BorderGray}" BorderThickness="1"
                            CornerRadius="6" Width="22" Height="22">
                        <Path Data="{StaticResource Icon.ShieldCheck}" Fill="#16A34A"
                              Stretch="Uniform" Width="12" Height="12"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="  SmogShield" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource DarkText}" VerticalAlignment="Center"/>
                    <TextBlock Text="  ·  Visitor Workspace" FontSize="11"
                               Foreground="{StaticResource LightGrayText}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource WinBtn}" Click="BtnMinimize_Click" ToolTip="Minimize">
                        <Path Data="{StaticResource Icon.WindowMinimize}" Fill="#333"
                              Stretch="Uniform" Width="11" Height="11"/>
                    </Button>
                    <Button Style="{StaticResource WinBtn}" Click="BtnMaximize_Click" ToolTip="Maximize / Restore">
                        <Path x:Name="MaxPath" Data="{StaticResource Icon.WindowMaximize}" Fill="#333"
                              Stretch="Uniform" Width="11" Height="11"/>
                    </Button>
                    <Button Style="{StaticResource WinBtnClose}" Click="BtnClose_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" MinWidth="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderGray}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="16,16,16,20">
                        <Border Background="{StaticResource LightGreen}" CornerRadius="8" Width="30" Height="30">
                            <Path Data="{StaticResource Icon.ShieldCheck}" Fill="#16A34A"
                                  Stretch="Uniform" Width="15" Height="15"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SmogShield" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource DarkText}"/>
                            <TextBlock Text="P A K I S T A N" FontSize="7"
                                       Foreground="{StaticResource LightGrayText}" Margin="0,-1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="12,0,12,0">
                        <TextBlock Text="WORKSPACE" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource LightGrayText}" Margin="12,0,0,8"/>

                        <Border Style="{StaticResource NavIdle}" MouseLeftButtonDown="NavDashboard_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Dashboard}" Fill="#6B7280"
                                      Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="  Dashboard" FontSize="13"
                                           Foreground="{StaticResource GrayText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NavIdle}" MouseLeftButtonDown="NavRanking_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.BarChart}" Fill="#6B7280"
                                      Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="  Ranking" FontSize="13"
                                           Foreground="{StaticResource GrayText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NavIdle}" MouseLeftButtonDown="NavSearch_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Search}" Fill="#6B7280"
                                      Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="  Search" FontSize="13"
                                           Foreground="{StaticResource GrayText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NavIdle}" MouseLeftButtonDown="NavCompare_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.CompareArrows}" Fill="#6B7280"
                                      Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="  Compare" FontSize="13"
                                           Foreground="{StaticResource GrayText}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource NavActive}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.SettingsGear}" Fill="#16743F"
                                      Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"/>
                                <TextBlock Text="  Settings" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#16743F" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="2" VerticalAlignment="Bottom"
                            Background="#F0FDF4" CornerRadius="10" Padding="14" Margin="12,0,12,10">
                        <StackPanel>
                            <Path Data="{StaticResource Icon.Leaf}" Fill="#16743F"
                                  Stretch="Uniform" Width="20" Height="20" Margin="0,0,0,8"/>
                            <TextBlock Text="Awareness starts here." FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource DarkText}" Margin="0,0,0,4"/>
                            <TextBlock TextWrapping="Wrap" FontSize="10" LineHeight="14"
                                       Foreground="{StaticResource GrayText}"
                                       Text="Built to explore air quality and the algorithms behind it."/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Background="Transparent" Cursor="Hand"
                            Padding="16,12" BorderBrush="{StaticResource BorderGray}" BorderThickness="0,1,0,0"
                            MouseLeftButtonDown="BtnEndSession_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource Icon.Logout}" Fill="#6B7280"
                                  Stretch="Uniform" Width="15" Height="15" VerticalAlignment="Center"/>
                            <TextBlock Text="  End visitor session" FontSize="12"
                                       Foreground="{StaticResource GrayText}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderGray}"
                        BorderThickness="0,0,0,1" Padding="20,12">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Workspace" FontSize="12"
                                       Foreground="{StaticResource LightGrayText}" VerticalAlignment="Center"/>
                            <Path Data="{StaticResource Icon.ChevronRight}" Fill="#9CA3AF"
                                  Stretch="Uniform" Width="12" Height="12" Margin="6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Settings" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource DarkText}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="#F3F4F6" CornerRadius="6" Padding="10,4" Margin="0,0,14,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#9CA3AF" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SourceBadgeText" Text="  SAMPLE DATA" FontSize="10" FontWeight="Bold"
                                               Foreground="#6B7280" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource LightGreen}" CornerRadius="14"
                                    Width="28" Height="28" Margin="0,0,8,0">
                                <TextBlock x:Name="VisitorInitials" Text="V" FontSize="10" FontWeight="Bold" Foreground="#16743F"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="VisitorNameText" Text="Visitor" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource DarkText}"/>
                                <TextBlock x:Name="VisitorRoleText" Text="Guest · Visitor" FontSize="10"
                                           Foreground="{StaticResource LightGrayText}" Margin="0,-1,0,0"/>
                            </StackPanel>
                            <Path Data="{StaticResource Icon.ChevronDown}" Fill="#9CA3AF"
                                  Stretch="Uniform" Width="12" Height="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" Padding="24,20">
                    <StackPanel>

                        <Grid Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Settings" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource DarkText}"/>
                                <TextBlock Text="Personalize your air-quality view and choose when readings need attention."
                                           FontSize="13" Foreground="{StaticResource GrayText}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Path Data="{StaticResource Icon.Calendar}" Fill="#9CA3AF"
                                      Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock x:Name="DateText" Text="" FontSize="12"
                                           Foreground="{StaticResource GrayText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#F9FAFB" BorderBrush="{StaticResource BorderGray}"
                                BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Info}" Fill="#6B7280"
                                      Stretch="Uniform" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock FontSize="12" Foreground="{StaticResource GrayText}" VerticalAlignment="Center"
                                           x:Name="DataNoticeText" Text="Loading live data from OpenAQ…"/>
                            </StackPanel>
                        </Border>

                        <Border Background="White" BorderBrush="{StaticResource BorderGray}"
                                BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,14">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{StaticResource LightGreen}" CornerRadius="20"
                                            Width="40" Height="40">
                                        <TextBlock x:Name="ProfileInitials" Text="V" FontSize="13" FontWeight="Bold" Foreground="#16743F"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="VisitorNameBig" Text="Visitor" FontSize="15" FontWeight="Bold"
                                                   Foreground="{StaticResource DarkText}"/>
                                        <TextBlock x:Name="ProfileRoleText" Text="Guest · Visitor · Logged-in session" FontSize="11"
                                                   Foreground="{StaticResource GrayText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <Border Background="#F0FDF4" CornerRadius="6" Padding="10,4"
                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="USER VIEW" FontSize="10"
                                               FontWeight="Bold" Foreground="#16743F"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Border Background="White" BorderBrush="{StaticResource BorderGray}"
                                        BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,16">
                                            <StackPanel>
                                                <TextBlock Text="Air quality preferences" FontSize="16" FontWeight="Bold"
                                                           Foreground="{StaticResource DarkText}"/>
                                                <TextBlock Text="Your display and threshold settings for this visitor session."
                                                           FontSize="11" Foreground="{StaticResource GrayText}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Border Background="#FEF3C7" CornerRadius="6" Padding="8,4" HorizontalAlignment="Right">
                                                <TextBlock x:Name="TxtUnsavedBadge" Text="UNSAVED EXAMPLE" FontSize="10"
                                                           FontWeight="Bold" Foreground="#92400E"/>
                                            </Border>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Path Data="{StaticResource Icon.Bell}" Fill="#16743F"
                                                  Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="  High Pollution Alert Limit" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource DarkText}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Flag a city or station when its PM2.5 concentration is greater than your limit."
                                                   FontSize="11" Foreground="{StaticResource GrayText}" Margin="0,0,0,10"
                                                   TextWrapping="Wrap"/>

                                        <Border Background="#F9FAFB" BorderBrush="#16A34A" BorderThickness="1.5"
                                                CornerRadius="8" Padding="14,10" Margin="0,0,0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="&gt;" FontSize="20" FontWeight="Bold"
                                                           Foreground="#16743F" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBox Grid.Column="1" x:Name="TxtLimit"
                                                         BorderThickness="0" Background="Transparent"
                                                         FontSize="22" FontWeight="Bold"
                                                         Foreground="{StaticResource DarkText}"
                                                         Text="100"
                                                         TextChanged="TxtLimit_TextChanged"/>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="µg/m³" FontSize="12"
                                                               Foreground="{StaticResource LightGrayText}" Margin="0,0,8,0"/>
                                                    <Path Data="{StaticResource Icon.ChevronDown}" Fill="#9CA3AF"
                                                          Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Grid Margin="0,0,0,14">
                                            <TextBlock x:Name="TxtSavedLimit" Text="Current saved limit: &gt; 75 µg/m³" FontSize="10"
                                                       Foreground="{StaticResource LightGrayText}"/>
                                            <TextBlock x:Name="TxtDraftLimit" Text="Draft limit: &gt; 100 µg/m³" FontSize="10"
                                                       FontWeight="SemiBold" Foreground="#16743F"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1"
                                                CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <Path Data="{StaticResource Icon.Zap}" Fill="#16A34A"
                                                          Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center"/>
                                                    <TextBlock Text="  Dashboard flags update immediately." FontSize="12"
                                                               FontWeight="SemiBold" Foreground="#16743F" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="Changing this limit affects Dashboard flags as soon as you save. No refresh is needed; the underlying readings stay the same."
                                                           FontSize="10" Foreground="#16A34A" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="Display unit" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource DarkText}" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Border x:Name="UnitUgm" Style="{StaticResource UnitBtnActive}"
                                                    MouseLeftButtonDown="UnitUgm_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Data="{StaticResource Icon.Check}" Fill="#16743F"
                                                          Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center"/>
                                                    <TextBlock Text="  µg/m³" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="#16743F" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <Border x:Name="UnitAqi" Style="{StaticResource UnitBtn}"
                                                    MouseLeftButtonDown="UnitAqi_Click">
                                                <TextBlock Text="AQI" FontSize="13" Foreground="#6B7280"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="µg/m³ shows pollutant concentration; AQI shows a separate air-quality index. The alert limit remains PM2.5 concentration in µg/m³."
                                                   FontSize="10" Foreground="{StaticResource LightGrayText}"
                                                   TextWrapping="Wrap" Margin="0,0,0,16"/>

                                        <Grid>
                                            <TextBlock x:Name="TxtChangeNote" Text="1 threshold change · Not saved yet"
                                                       FontSize="10" Foreground="{StaticResource LightGrayText}"
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Border Background="#F3F4F6" CornerRadius="6" Padding="16,8" Cursor="Hand"
                                                        MouseLeftButtonDown="BtnCancel_Click">
                                                    <TextBlock Text="Cancel" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280"/>
                                                </Border>
                                                <Border Background="#16A34A" CornerRadius="6" Padding="16,8" Cursor="Hand" Margin="8,0,0,0"
                                                        MouseLeftButtonDown="BtnSave_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource Icon.Check}" Fill="White"
                                                              Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center"/>
                                                        <TextBlock Text="  Save Changes" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="White" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="White" BorderBrush="{StaticResource BorderGray}"
                                        BorderThickness="1" CornerRadius="10" Padding="18">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource Icon.Sun}" Fill="#16A34A"
                                                  Stretch="Uniform" Width="22" Height="22" VerticalAlignment="Center"/>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="Light workspace" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource DarkText}"/>
                                                <TextBlock Text="A clear, high-contrast view for exploring detailed air-quality data."
                                                           FontSize="10" Foreground="{StaticResource GrayText}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Background="#F3F4F6" CornerRadius="6" Padding="10,4"
                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="LIGHT MODE" FontSize="10" FontWeight="Bold"
                                                       Foreground="#6B7280"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Border Background="White" BorderBrush="{StaticResource BorderGray}"
                                        BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,14">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <TextBlock Text="Dashboard flag preview" FontSize="14" FontWeight="Bold"
                                                       Foreground="{StaticResource DarkText}"/>
                                            <Path Data="{StaticResource Icon.Eye}" Fill="#16743F"
                                                  Stretch="Uniform" Width="16" Height="16"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock x:Name="TxtPreviewSub" Text="Effect of your draft limit on current readings."
                                                   FontSize="10" Foreground="{StaticResource LightGrayText}"
                                                   TextWrapping="Wrap" Margin="0,0,0,12"/>

                                        <Border BorderBrush="{StaticResource BorderGray}" BorderThickness="0,1,0,0" Padding="0,10,0,10">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="Lahore" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource DarkText}"/>
                                                    <TextBlock x:Name="TxtLahoreVal" Text="128.6 µg/m³" FontSize="13" FontWeight="Bold"
                                                               Foreground="{StaticResource DarkText}" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Border x:Name="BadgeLahore" Background="#FEE2E2" CornerRadius="4"
                                                        Padding="6,2" HorizontalAlignment="Left" Margin="0,4,0,0">
                                                    <TextBlock x:Name="TxtLahoreBadge" Text="ABOVE THRESHOLD" FontSize="9"
                                                               FontWeight="Bold" Foreground="#DC2626"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <Border BorderBrush="{StaticResource BorderGray}" BorderThickness="0,1,0,0" Padding="0,10,0,10">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="Karachi" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource DarkText}"/>
                                                    <TextBlock x:Name="TxtKarachiVal" Text="78.4 µg/m³" FontSize="13" FontWeight="Bold"
                                                               Foreground="{StaticResource DarkText}" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid Margin="0,4,0,0">
                                                    <Border x:Name="BadgeKarachi" Background="#F3F4F6" CornerRadius="4"
                                                            Padding="6,2" HorizontalAlignment="Left">
                                                        <TextBlock x:Name="TxtKarachiBadge" Text="BELOW THRESHOLD" FontSize="9"
                                                                   FontWeight="Bold" Foreground="#6B7280"/>
                                                    </Border>
                                                    <TextBlock x:Name="TxtKarachiNote" Text="" FontSize="9"
                                                               Foreground="{StaticResource LightGrayText}" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border BorderBrush="{StaticResource BorderGray}" BorderThickness="0,1,0,0" Padding="0,10,0,10">
                                            <StackPanel>
                                                <Grid>
                                                    <TextBlock Text="Islamabad" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource DarkText}"/>
                                                    <TextBlock x:Name="TxtIslamabadVal" Text="35.2 µg/m³" FontSize="13" FontWeight="Bold"
                                                               Foreground="{StaticResource DarkText}" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Border x:Name="BadgeIslamabad" Background="#F3F4F6" CornerRadius="4"
                                                        Padding="6,2" HorizontalAlignment="Left" Margin="0,4,0,0">
                                                    <TextBlock x:Name="TxtIslamabadBadge" Text="BELOW THRESHOLD" FontSize="9"
                                                               FontWeight="Bold" Foreground="#6B7280"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="#F0FDF4" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource Icon.Info}" Fill="#16A34A"
                                                      Stretch="Uniform" Width="13" Height="13" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtFlaggedCount" Text="  Flagged cities: 2 → 1 in this preview"
                                                           FontSize="11" Foreground="#16743F" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Background="White" BorderBrush="{StaticResource BorderGray}"
                                        BorderThickness="1" CornerRadius="10" Padding="18">
                                    <StackPanel>
                                        <TextBlock Text="What changes — and what doesn't" FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource DarkText}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <TextBlock Text="Your limit changes personal Dashboard flags only. It does not change readings, city rankings or official AQI categories."
                                                   FontSize="11" Foreground="{StaticResource GrayText}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                        <Border BorderBrush="{StaticResource BorderGray}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                            <TextBlock Text="Saved limit persists across sessions and applies to your Dashboard flags immediately."
                                                       FontSize="10" Foreground="{StaticResource LightGrayText}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
